
@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Detalles del evento";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">← Volver a eventos</a>
    <h1 class="mt-3">Detalles del evento</h1>
    <p class="text-muted">Consulta toda la información registrada.</p>
</div>

<div class="card">
    <div class="card-header">Información general</div>
    <div class="card-body">
        <h2 class="h4 mb-4">@Model.Titulo</h2>

        <dl class="row mb-0">
            <dt class="col-sm-4 mb-2">Categoría</dt>
            <dd class="col-sm-8 mb-3">@(Model.Categoria?.Nombre ?? "Sin categoría")</dd>

            <dt class="col-sm-4 mb-2">Fecha y hora</dt>
            <dd class="col-sm-8 mb-3">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4 mb-2">Lugar</dt>
            <dd class="col-sm-8 mb-3">@Model.Lugar</dd>

            <dt class="col-sm-4 mb-2">Modalidad</dt>
            <dd class="col-sm-8 mb-3">@Model.Modalidad</dd>

            <dt class="col-sm-4 mb-2">Aforo</dt>
            <dd class="col-sm-8 mb-3">@Model.Aforo personas</dd>

            <dt class="col-sm-4 mb-2">Precio</dt>
            <dd class="col-sm-8 mb-3">@(Model.Precio == 0 ? "Gratis" : $"S/ {Model.Precio:N2}")</dd>

            <dt class="col-sm-4 mb-2">Estado</dt>
            <dd class="col-sm-8 mb-3">@(Model.Activo ? "Activo" : "Inactivo")</dd>
        </dl>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Editar evento</a>
            <a asp-action="Index" class="btn btn-outline-primary">Volver al listado</a>
        </div>
    </div>
</div>
