
@model IEnumerable<Eventos.Web.Models.Evento>

@{
    ViewData["Title"] = "Eventos";
    var categorias = ViewBag.Categorias as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    int? categoriaSeleccionada = ViewBag.CategoriaId as int?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="text-uppercase small fw-bold" style="color:#246B45;letter-spacing:2px">
            DESCUBRE Y ORGANIZA
        </span>
        <h1 class="mt-2 mb-2">Explora nuestros eventos</h1>
        <p class="text-muted mb-0">Encuentra tu próxima experiencia y reserva tu lugar.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Crear evento
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get"
              class="d-flex flex-wrap align-items-end gap-3">
            <div class="flex-grow-1" style="min-width:220px">
                <label for="categoriaId" class="form-label">Filtrar por categoría</label>
                <select id="categoriaId" name="categoriaId"
                        class="form-select" asp-items="categorias">
                    <option value="">Todas las categorías</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Filtrar eventos
            </button>

            <a asp-action="Index" class="btn btn-outline-primary">
                Limpiar
            </a>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var evento in Model)
        {
            int inscritos = evento.Inscripciones.Count;
            int disponibles = Math.Max(0, evento.Aforo - inscritos);

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 tarjeta-evento">
                    <div class="imagen-evento">
                        <div class="imagen-evento-contenido">
                            <span class="etiqueta-evento">
                                @(evento.Categoria?.Nombre ?? "General")
                            </span>
                            <span class="icono-evento">✦</span>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 mb-0">@evento.Titulo</h2>
                            <span class="precio-evento">
                                @(evento.Precio == 0 ? "Gratis" : $"S/ {evento.Precio:N2}")
                            </span>
                        </div>

                        <p class="text-muted small mb-2">
                            <strong>Fecha:</strong>
                            @evento.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="text-muted small mb-2">
                            <strong>Lugar:</strong> @evento.Lugar
                        </p>

                        <p class="text-muted small mb-2">
                            <strong>Modalidad:</strong> @evento.Modalidad
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                            <span class="small text-muted">Cupos disponibles</span>
                            <strong style="color:#246B45">@disponibles / @evento.Aforo</strong>
                        </div>

                        <div class="barra-aforo mb-3">
                            <div class="barra-aforo-progreso"
                                 style="width:@(evento.Aforo > 0 ? Math.Min(100, inscritos * 100.0 / evento.Aforo) : 0)%">
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@evento.Id"
                               class="btn btn-outline-primary btn-sm">
                                Detalles
                            </a>
                            <a asp-action="Edit" asp-route-id="@evento.Id"
                               class="btn btn-primary btn-sm">
                                Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@evento.Id"
                               class="btn btn-outline-danger btn-sm">
                                Desactivar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card text-center py-5">
        <div class="card-body">
            <h2 class="h4">No hay eventos para mostrar</h2>
            <p class="text-muted">Prueba otra categoría o registra un nuevo evento.</p>
            <a asp-action="Create" class="btn btn-success">Crear evento</a>
        </div>
    </div>
}
