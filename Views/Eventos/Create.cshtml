
@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Crear evento";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">← Volver a eventos</a>
    <h1 class="mt-3">Crear un evento</h1>
    <p class="text-muted">Completa los datos para registrar una nueva experiencia.</p>
</div>

<div class="card formulario-evento">
    <div class="card-header">Información del evento</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Titulo" class="form-label">Título</label>
                    <input asp-for="Titulo" class="form-control" placeholder="Nombre del evento" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Fecha" class="form-label">Fecha y hora</label>
                    <input asp-for="Fecha" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Lugar" class="form-label">Lugar</label>
                    <input asp-for="Lugar" class="form-control" placeholder="Lugar del evento" />
                    <span asp-validation-for="Lugar" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label">Categoría</label>
                    <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
                        <option value="">Selecciona una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Modalidad" class="form-label">Modalidad</label>
                    <select asp-for="Modalidad" class="form-select">
                        <option value="Presencial">Presencial</option>
                        <option value="Virtual">Virtual</option>
                    </select>
                    <span asp-validation-for="Modalidad" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Aforo" class="form-label">Aforo máximo</label>
                    <input asp-for="Aforo" type="number" class="form-control" min="1" max="5000" />
                    <span asp-validation-for="Aforo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label">Precio (S/)</label>
                    <input asp-for="Precio" type="number" class="form-control" min="0" step="0.01" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-success">Guardar evento</button>
                <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
