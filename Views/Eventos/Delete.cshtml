
@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Desactivar evento";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">← Volver a eventos</a>
    <h1 class="mt-3">Desactivar evento</h1>
    <p class="text-muted">Confirma la desactivación del evento seleccionado.</p>
</div>

<div class="card">
    <div class="card-body">
        <div class="alert alert-warning">
            ¿Estás seguro de que deseas desactivar este evento? No se eliminará físicamente de la base de datos.
        </div>

        <h2 class="h4">@Model.Titulo</h2>
        <p class="text-muted">@Model.Fecha.ToString("dd/MM/yyyy HH:mm") · @Model.Lugar</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-danger">Sí, desactivar</button>
                <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
