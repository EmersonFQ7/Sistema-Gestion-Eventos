
@model Eventos.Web.Models.Asistente

@{
    ViewData["Title"] = "Registrar asistente";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">← Volver a asistentes</a>
    <h1 class="mt-3">Registrar asistente</h1>
    <p class="text-muted">Completa los datos de la persona que participará en los eventos.</p>
</div>

<div class="card formulario-evento">
    <div class="card-header">Datos personales</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Nombres" class="form-label">Nombres completos</label>
                    <input asp-for="Nombres" class="form-control" placeholder="Ingresa los nombres completos" />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Dni" class="form-label">DNI</label>
                    <input asp-for="Dni" class="form-control" maxlength="8"
                           inputmode="numeric" placeholder="8 dígitos" />
                    <span asp-validation-for="Dni" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label">Correo electrónico</label>
                    <input asp-for="Correo" type="email" class="form-control"
                           placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label">Teléfono (opcional)</label>
                    <input asp-for="Telefono" class="form-control"
                           maxlength="9" inputmode="numeric"
                           placeholder="Máximo 9 caracteres" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-success">Guardar asistente</button>
                <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
